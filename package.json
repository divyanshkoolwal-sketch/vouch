{
  "name": "@divyanshkoolwal-sketch/vouch",
  "version": "0.3.1",
  "description": "An automatic trust/verification layer for AI coding agents — works with Claude Code, OpenAI Codex, and Cursor.",
  "bin": {
    "vouch": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts",
    "skills",
    "commands",
    "agents",
    "hooks",
    ".claude-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": "github:divyanshkoolwal-sketch/vouch",
  "license": "MIT",
  "keywords": ["verification", "code-review", "ai-agents", "claude-code", "codex", "cursor", "mcp", "hooks"],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node build.mjs && node dist/eval.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
